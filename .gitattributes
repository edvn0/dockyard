# Default: normalize to LF
* text=auto eol=lf

# Explicitly LF
*.cpp    text eol=lf
*.hpp    text eol=lf
*.h      text eol=lf
*.c      text eol=lf
*.slang  text eol=lf
*.py     text eol=lf
*.lua    text eol=lf
*.sh     text eol=lf
*.cmake  text eol=lf
CMakeLists.txt text eol=lf

# Windows-only scripts (if any)
*.bat    text eol=crlf
*.ps1    text eol=crlf

# Binary — never touch
*.ktx2   binary
*.png    binary
*.jpg    binary
*.spv    binary
*.bin    binary

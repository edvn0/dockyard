{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "ninja-debug",
      "displayName": "Ninja Debug",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ninja-release",
      "displayName": "Ninja Release",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "ninja-relwithdebinfo",
      "displayName": "Ninja RelWithDebInfo",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "ninja-debug",
      "targets": ["dockforge", "gltf-imagemap", "dockyard-testing"]
    },
    {
      "name": "release",
      "configurePreset": "ninja-release",
      "targets": ["dockforge", "gltf-imagemap", "dockyard-testing"]
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "ninja-relwithdebinfo",
      "targets": ["dockforge", "gltf-imagemap", "dockyard-testing"]
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "ninja-debug",
      "output": { "verbosity": "default" }
    },
    {
      "name": "release",
      "configurePreset": "ninja-release",
      "output": { "verbosity": "default" }
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "ninja-relwithdebinfo",
      "output": { "verbosity": "default" }
    }
  ],
  "workflowPresets": [
    {
      "name": "debug",
      "displayName": "Configure, build, and test Debug",
      "steps": [
        { "type": "configure", "name": "ninja-debug" },
        { "type": "build",     "name": "debug" },
        { "type": "test",      "name": "debug" }
      ]
    },
    {
      "name": "release",
      "displayName": "Configure, build, and test Release",
      "steps": [
        { "type": "configure", "name": "ninja-release" },
        { "type": "build",     "name": "release" },
        { "type": "test",      "name": "release" }
      ]
    },
    {
      "name": "relwithdebinfo",
      "displayName": "Configure, build, and test RelWithDebInfo",
      "steps": [
        { "type": "configure", "name": "ninja-relwithdebinfo" },
        { "type": "build",     "name": "relwithdebinfo" },
        { "type": "test",      "name": "relwithdebinfo" }
      ]
    }
  ]
}
